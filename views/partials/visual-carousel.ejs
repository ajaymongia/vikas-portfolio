<div class="carousel visual-carousel" data-carousel data-autoscroll="16">
  <div class="carousel-viewport" tabindex="0" role="group" aria-label="Archive gallery, scrollable">
    <ul class="carousel-track">
      <% visuals.forEach(function (v, i) { %>
        <li class="carousel-item visual-slide">
          <% if (v.link) { %><a class="visual-link" href="<%= v.link %>" target="_blank" rel="noopener"><% } %>
          <figure class="visual">
            <div class="visual-frame">
              <img src="<%= v.src %>" alt="<%= v.title %> — <%= v.caption %>"
                   width="808" height="632"
                   loading="<%= i < 2 ? 'eager' : 'lazy' %>" decoding="async">
            </div>
            <figcaption>
              <p class="visual-tag"><%= v.tag %></p>
              <h3 class="visual-title"><%= v.title %><% if (v.link) { %> <span class="visual-arrow" aria-hidden="true">↗</span><% } %></h3>
              <p class="visual-caption"><%= v.caption %></p>
            </figcaption>
          </figure>
          <% if (v.link) { %></a><% } %>
        </li>
      <% }); %>
    </ul>
  </div>
  <%- include('carousel-controls') %>
</div>
